{
	"name": "pipeline1",
	"properties": {
		"activities": [
			{
				"name": "Activity 2",
				"description": "I want to copy data one contsiner to another",
				"type": "Copy",
				"dependsOn": [],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"sink": {
						"type": "DelimitedTextSink",
						"storeSettings": {
							"type": "AzureBlobStorageWriteSettings"
						},
						"formatSettings": {
							"type": "DelimitedTextWriteSettings",
							"quoteAllText": true,
							"fileExtension": ".txt"
						}
					},
					"enableStaging": false,
					"translator": {
						"type": "TabularTranslator",
						"mappings": [
							{
								"sink": {
									"path": "$['Column_1']"
								}
							}
						]
					}
				},
				"outputs": [
					{
						"referenceName": "ADLSourceLinkeService",
						"type": "DatasetReference"
					}
				]
			}
		],
		"annotations": []
	}
}